# ==========================================
# FakeReviewDetection - .gitignore
# ==========================================


# ------------------------------------------
# Python cache / compiled files
# ------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so


# ------------------------------------------
# Virtual environments
# ------------------------------------------
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/


# ------------------------------------------
# Environment / secrets
# ------------------------------------------
.env
.env.*
!.env.example


# ------------------------------------------
# Jupyter Notebook
# ------------------------------------------
.ipynb_checkpoints/
*/.ipynb_checkpoints/


# ------------------------------------------
# IDE / Editor files
# ------------------------------------------
.vscode/
.idea/
*.suo
*.swp
*.user
*.userosscache
*.sln


# ------------------------------------------
# Operating System files
# ------------------------------------------
.DS_Store
Thumbs.db


# ------------------------------------------
# Python packaging
# ------------------------------------------
build/
dist/
downloads/
eggs/
.eggs/
*.egg-info/
.installed.cfg
*.egg
MANIFEST


# ------------------------------------------
# SQLite temporary files
# ------------------------------------------
*.db-journal
*.sqlite-journal

# Keep database.db if your project needs
# the existing demo database.
# database.db is intentionally NOT ignored.


# ------------------------------------------
# SQLiteStudio project files
# ------------------------------------------
*.sqbpro


# ------------------------------------------
# Generated exports
# ------------------------------------------
exports/*
!exports/.gitkeep


# ------------------------------------------
# TextBlob downloaded data
# ------------------------------------------
textblob_data/


# ------------------------------------------
# Project files that MUST remain tracked
# ------------------------------------------
# dataset/              -> KEEP
# models/model.pkl     -> KEEP
# models/tfidf.pkl     -> KEEP
# static/charts/       -> KEEP

dataset/
exports/
static/charts/
models/*.pkl
models/*.joblib
*.db
*.sqlite
.env
venv/